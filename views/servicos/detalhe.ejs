<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= servico.titulo %> - Serv-Link</title>
    <link rel="stylesheet" href="/css/base/estilo.css" />
    <link rel="stylesheet" href="/css/servicos/detalhe.css" />
  </head>
  <body>
    <% if (sessao && sessao.perfil === "cliente") { %>
      <%- include("../partials/navbar-cliente") %>
    <% } else { %>
      <%- include("../partials/navbar-public") %>
    <% } %>

    <main style="padding:20px;">
      <p><a href="/servicos">← Voltar a servicos</a></p>

      <div style="display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:24px;align-items:start;">
        <section>
          <h1><%= servico.titulo %></h1>
          <p><%= servico.descricao || "" %></p>
          <p>Categoria: <%= servico.categorias ? servico.categorias.nome : "N/A" %></p>
          <p>Preco: <%= formatarPreco(servico.preco) %> / <%= servico.unidade_preco || "servico" %></p>

          <% if (servico.prestadores) { %>
            <section style="margin-top:20px;">
              <h2>Prestador</h2>
              <p>Nome: <%= servico.prestadores.utilizadores ? servico.prestadores.utilizadores.nome : "N/A" %></p>
              <p>Especialidade: <%= servico.prestadores.especialidade || "N/A" %></p>
              <p>Avaliacao: <%= servico.prestadores.avaliacao_media || 0 %> (<%= servico.prestadores.total_avaliacoes || 0 %>)</p>
              <p>Cidade: <%= servico.prestadores.cidade || "N/A" %></p>
              <p><a href="/prestador/<%= servico.prestadores.id %>/perfil">Ver perfil publico</a></p>
            </section>
          <% } %>

          <section style="margin-top:20px;">
            <h2>Avaliacoes recentes</h2>
            <% if (avaliacoes.length === 0) { %>
              <p>Sem avaliacoes no momento.</p>
            <% } else { %>
              <ul>
                <% avaliacoes.forEach((a) => { %>
                  <li>
                    <strong><%= a.clientes && a.clientes.utilizadores ? a.clientes.utilizadores.nome : "Cliente" %></strong>
                    — <%= a.pontuacao %>/5 — <%= formatarData(a.criado_em) %>
                    <br />
                    <%= a.comentario || "" %>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </section>
        </section>

        <aside style="border:1px solid #ddd;border-radius:8px;padding:16px;">
          <h2>Requisitar servico</h2>
          <% if (sessao && sessao.perfil === "cliente") { %>
            <form id="form-pedido">
              <input type="hidden" name="servicoId" value="<%= servico.id %>" />
              <p><input type="text" name="nomeCliente" value="<%= sessao.nome %>" placeholder="Nome completo" required /></p>
              <p><input type="text" name="telefone" placeholder="Telefone" required /></p>
              <p><input type="text" name="local" placeholder="Local do servico" required /></p>
              <p>
                <select name="periodo">
                  <option value="Manha">Manha</option>
                  <option value="Tarde">Tarde</option>
                  <option value="Noite">Noite</option>
                  <option value="Qualquer">Qualquer</option>
                </select>
              </p>
              <p>
                <select name="urgencia">
                  <option value="Normal">Normal</option>
                  <option value="Urgente">Urgente</option>
                  <option value="Muito Urgente">Muito Urgente</option>
                </select>
              </p>
              <p><textarea name="descricao" placeholder="Descreva o que precisa"></textarea></p>
              <p id="pedido-feedback"></p>
              <button type="submit" id="btn-pedido">Enviar pedido</button>
            </form>
          <% } else if (sessao && sessao.perfil === "prestador") { %>
            <p>Prestadores nao podem abrir pedidos.</p>
          <% } else { %>
            <p>Entre como cliente para enviar um pedido.</p>
            <p><a href="/auth/login/cliente">Entrar como cliente</a></p>
          <% } %>
        </aside>
      </div>
    </main>

    <%- include("../partials/footer-simples") %>
    <script src="/js/pedido.js"></script>
  </body>
  </html>
